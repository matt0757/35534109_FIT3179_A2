{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Diverging bars: change in visitors by purpose of visit, year to June 2026 versus calendar 2019, in thousands.",
 "width": "container",
 "height": {
  "step": 34
 },
 "padding": {
  "left": 6,
  "right": 150,
  "top": 28,
  "bottom": 6
 },
 "autosize": {
  "type": "fit",
  "contains": "padding"
 },
 "data": {
  "url": "data/chart7_purpose_duration.csv",
  "format": {
   "type": "csv",
   "parse": {
    "v2019": "number",
    "v2026": "number",
    "pct": "number",
    "order": "number"
   }
  }
 },
 "transform": [
  {
   "filter": "datum.group === 'reason'"
  },
  {
   "calculate": "(datum.v2026 - datum.v2019) / 1000",
   "as": "change_k"
  }
 ],
 "layer": [
  {
   "mark": {
    "type": "bar",
    "size": 16
   },
   "encoding": {
    "x": {
     "field": "change_k",
     "type": "quantitative",
     "scale": {
      "domain": [
       -500,
       260
      ],
      "nice": false
     },
     "title": "Change in visitors since 2019 (thousands)",
     "axis": {
      "values": [
       -400,
       -300,
       -200,
       -100,
       0,
       100,
       200
      ],
      "labelExpr": "datum.value == 0 ? '0' : (datum.value > 0 ? '+' : '−') + abs(datum.value)",
      "grid": true,
      "gridColor": "#eceff1",
      "domain": false,
      "ticks": false,
      "titleFontSize": 12,
      "labelFontSize": 12,
      "titlePadding": 8
     }
    },
    "y": {
     "field": "item",
     "type": "nominal",
     "sort": {
      "field": "change_k",
      "op": "min",
      "order": "descending"
     },
     "title": null,
     "axis": {
      "labelFontSize": 12,
      "ticks": false,
      "domain": false,
      "labelLimit": 240,
      "labelPadding": 8,
      "minExtent": 150
     }
    },
    "color": {
     "condition": {
      "test": "datum.change_k >= 0",
      "value": "#2166ac"
     },
     "value": "#b2182b"
    },
    "tooltip": [
     {
      "field": "item",
      "title": "Group"
     },
     {
      "field": "v2019",
      "title": "Calendar 2019",
      "format": ","
     },
     {
      "field": "v2026",
      "title": "Year to Jun 2026",
      "format": ","
     },
     {
      "field": "change_k",
      "title": "Change (thousands)",
      "format": "+,.0f"
     },
     {
      "field": "pct",
      "title": "% of 2019",
      "format": ".0f"
     }
    ]
   }
  },
  {
   "data": {
    "values": [
     {
      "zero": 0
     }
    ]
   },
   "mark": {
    "type": "rule",
    "color": "#555",
    "strokeWidth": 1.2
   },
   "encoding": {
    "x": {
     "field": "zero",
     "type": "quantitative",
     "scale": {
      "domain": [
       -500,
       260
      ],
      "nice": false
     },
     "title": "Change in visitors since 2019 (thousands)"
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.change_k >= 0"
    },
    {
     "calculate": "(datum.change_k >= 0 ? '+' : '−') + format(round(abs(datum.change_k)), ',') + 'K'",
     "as": "chg"
    }
   ],
   "mark": {
    "type": "text",
    "align": "left",
    "baseline": "middle",
    "dx": 6,
    "fontSize": 12,
    "fontWeight": "bold",
    "color": "#222"
   },
   "encoding": {
    "x": {
     "field": "change_k",
     "type": "quantitative",
     "scale": {
      "domain": [
       -500,
       260
      ],
      "nice": false
     },
     "title": "Change in visitors since 2019 (thousands)"
    },
    "y": {
     "field": "item",
     "type": "nominal",
     "sort": {
      "field": "change_k",
      "op": "min",
      "order": "descending"
     },
     "title": null,
     "axis": {
      "labelFontSize": 12,
      "ticks": false,
      "domain": false,
      "labelLimit": 240,
      "labelPadding": 8,
      "minExtent": 150
     }
    },
    "text": {
     "field": "chg"
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.change_k < 0"
    },
    {
     "calculate": "(datum.change_k >= 0 ? '+' : '−') + format(round(abs(datum.change_k)), ',') + 'K'",
     "as": "chg"
    }
   ],
   "mark": {
    "type": "text",
    "align": "right",
    "baseline": "middle",
    "dx": -6,
    "fontSize": 12,
    "fontWeight": "bold",
    "color": "#222"
   },
   "encoding": {
    "x": {
     "field": "change_k",
     "type": "quantitative",
     "scale": {
      "domain": [
       -500,
       260
      ],
      "nice": false
     },
     "title": "Change in visitors since 2019 (thousands)"
    },
    "y": {
     "field": "item",
     "type": "nominal",
     "sort": {
      "field": "change_k",
      "op": "min",
      "order": "descending"
     },
     "title": null,
     "axis": {
      "labelFontSize": 12,
      "ticks": false,
      "domain": false,
      "labelLimit": 240,
      "labelPadding": 8,
      "minExtent": 150
     }
    },
    "text": {
     "field": "chg"
    }
   }
  },
  {
   "transform": [
    {
     "calculate": "datum.v2026 >= 1000000 ? format(datum.v2026 / 1000000, '.2f') + 'M' : format(round(datum.v2026 / 1000), ',') + 'K'",
     "as": "size"
    }
   ],
   "mark": {
    "type": "text",
    "align": "left",
    "baseline": "middle",
    "fontSize": 12,
    "color": "#444"
   },
   "encoding": {
    "x": {
     "value": {
      "expr": "width + 20"
     }
    },
    "y": {
     "field": "item",
     "type": "nominal",
     "sort": {
      "field": "change_k",
      "op": "min",
      "order": "descending"
     },
     "title": null,
     "axis": {
      "labelFontSize": 12,
      "ticks": false,
      "domain": false,
      "labelLimit": 240,
      "labelPadding": 8,
      "minExtent": 150
     }
    },
    "text": {
     "field": "size"
    }
   }
  },
  {
   "transform": [
    {
     "calculate": "(datum.pct >= 100 ? '+' : '−') + format(abs(datum.pct - 100), '.0f') + '%'",
     "as": "pl"
    }
   ],
   "mark": {
    "type": "text",
    "align": "left",
    "baseline": "middle",
    "fontSize": 12,
    "fontWeight": "bold"
   },
   "encoding": {
    "x": {
     "value": {
      "expr": "width + 96"
     }
    },
    "y": {
     "field": "item",
     "type": "nominal",
     "sort": {
      "field": "change_k",
      "op": "min",
      "order": "descending"
     },
     "title": null,
     "axis": {
      "labelFontSize": 12,
      "ticks": false,
      "domain": false,
      "labelLimit": 240,
      "labelPadding": 8,
      "minExtent": 150
     }
    },
    "text": {
     "field": "pl"
    },
    "color": {
     "condition": {
      "test": "datum.pct >= 100",
      "value": "#2166ac"
     },
     "value": "#b2182b"
    }
   }
  },
  {
   "data": {
    "values": [
     {
      "a": 1
     }
    ]
   },
   "mark": {
    "type": "text",
    "align": "left",
    "baseline": "bottom",
    "fontSize": 11,
    "color": "#555"
   },
   "encoding": {
    "x": {
     "value": {
      "expr": "width + 20"
     }
    },
    "y": {
     "value": -8
    },
    "text": {
     "value": "Latest year"
    }
   }
  },
  {
   "data": {
    "values": [
     {
      "a": 1
     }
    ]
   },
   "mark": {
    "type": "text",
    "align": "left",
    "baseline": "bottom",
    "fontSize": 11,
    "color": "#555"
   },
   "encoding": {
    "x": {
     "value": {
      "expr": "width + 96"
     }
    },
    "y": {
     "value": -8
    },
    "text": {
     "value": "vs 2019"
    }
   }
  }
 ],
 "config": {
  "view": {
   "stroke": null
  },
  "text": {
   "font": "Arial"
  },
  "axis": {
   "labelColor": "#444",
   "titleColor": "#333"
  }
 }
}