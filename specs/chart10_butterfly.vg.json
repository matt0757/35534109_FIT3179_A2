{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Butterfly chart: tourism jobs for men (left) and women (right), split full-time and part-time, 2017 to year to June 2026.",
 "width": "container",
 "height": {
  "step": 30
 },
 "padding": {
  "left": 6,
  "right": 16,
  "top": 44,
  "bottom": 6
 },
 "autosize": {
  "type": "fit",
  "contains": "padding"
 },
 "data": {
  "url": "data/chart10_butterfly.csv",
  "format": {
   "type": "csv",
   "parse": {
    "jobs_k": "number",
    "signed": "number",
    "sex_total": "number",
    "signed_total": "number",
    "pt_share": "number",
    "order": "number",
    "emp_order": "number"
   }
  }
 },
 "layer": [
  {
   "mark": {
    "type": "bar",
    "stroke": "#ffffff",
    "strokeWidth": 0.8,
    "height": {
     "band": 0.82
    }
   },
   "encoding": {
    "x": {
     "field": "signed",
     "type": "quantitative",
     "scale": {
      "domain": [
       -400,
       400
      ],
      "nice": false
     },
     "title": "Tourism jobs (thousands, average over the period)",
     "axis": {
      "values": [
       -400,
       -300,
       -200,
       -100,
       0,
       100,
       200,
       300,
       400
      ],
      "labelExpr": "abs(datum.value)",
      "grid": true,
      "gridColor": "#e6e8ea",
      "labelFontSize": 12,
      "titleFontSize": 12
     }
    },
    "y": {
     "field": "period",
     "type": "ordinal",
     "sort": {
      "field": "order"
     },
     "title": null,
     "axis": {
      "labelFontSize": 13,
      "ticks": false,
      "domain": false,
      "labelPadding": 8
     }
    },
    "color": {
     "field": "cat",
     "type": "nominal",
     "title": null,
     "scale": {
      "domain": [
       "Male full-time",
       "Male part-time",
       "Female full-time",
       "Female part-time"
      ],
      "range": [
       "#2a6f97",
       "#8fc1dc",
       "#a4478c",
       "#e2aad6"
      ]
     },
     "legend": {
      "orient": "bottom",
      "direction": "horizontal",
      "symbolType": "square",
      "symbolSize": 150,
      "labelFontSize": 13,
      "columnPadding": 16
     }
