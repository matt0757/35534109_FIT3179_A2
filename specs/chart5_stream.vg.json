{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Streamgraph: visitors in the 12 months to each month, by region of origin, Dec 2017 to Jun 2026.",
  "width": "container",
  "height": 420,
  "padding": {
    "left": 8,
    "right": 8,
    "top": 34,
    "bottom": 8
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "layer": [
    {
      "data": {
        "url": "data/chart5_stream.csv"
      },
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "stroke": "#ffffff",
        "strokeWidth": 0.6
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "scale": {
            "type": "utc",
            "domain": [
              "2018-01-01",
              "2026-06-01"
            ]
          },
          "title": null,
          "axis": {
            "format": "%Y",
            "tickCount": 9,
            "labelAngle": 0,
            "grid": false,
            "domain": true
          }
        },
        "y": {
          "field": "visitors_m",
          "type": "quantitative",
          "stack": "center",
          "scale": {
            "domain": [
              0,
              9.6
            ]
          },
          "axis": null
        },
        "color": {
          "field": "region",
          "type": "nominal",
          "scale": {
            "domain": [
              "North-East Asia",
              "South-East Asia",
              "South & Central Asia",
              "Oceania",
              "Europe",
              "Americas",
              "Africa & Middle East"
            ],
            "range": [
              "#9e2e6a",
              "#819f44",
              "#9d6f66",
              "#45adb5",
              "#5e69b7",
              "#daae3a",
              "#585858"
            ]
          },
          "legend": null
        },
        "order": {
          "field": "order",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "region",
            "title": "Region"
          },
          {
            "field": "month",
            "title": "12 months to"
          },
          {
            "field": "visitors_m",
            "title": "Visitors (millions)",
            "format": ".2f"
          }
        ],
        "opacity": {
          "condition": {
            "param": "region_hover",
            "empty": true,
            "value": 1
          },
          "value": 0.35
        }
      },
      "params": [
        {
          "name": "region_hover",
          "select": {
            "type": "point",
            "fields": [
              "region"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "date": "2020-03-20",
            "t": "Borders largely closed\n(Mar 2020)"
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#555",
        "strokeDash": [
          4,
          3
        ],
        "strokeWidth": 1.3
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "scale": {
            "type": "utc",
            "domain": [
              "2018-01-01",
              "2026-06-01"
            ]
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "2020-03-20",
            "t": "Borders close\n(Mar 2020)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dx": -5,
        "dy": -4,
        "fontSize": 12,
        "color": "#444",
        "lineBreak": "\n"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "scale": {
            "type": "utc",
            "domain": [
              "2018-01-01",
              "2026-06-01"
            ]
          }
        },
        "y": {
          "value": -4
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "2022-02-21",
            "t": "Borders reopen\n(Feb 2022)"
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#555",
        "strokeDash": [
          4,
          3
        ],
        "strokeWidth": 1.3
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "scale": {
            "type": "utc",
            "domain": [
              "2018-01-01",
              "2026-06-01"
            ]
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "2022-02-21",
            "t": "Borders reopen\n(Feb 2022)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 5,
        "dy": -4,
        "fontSize": 12,
        "color": "#444",
        "lineBreak": "\n"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "scale": {
            "type": "utc",
            "domain": [
              "2018-01-01",
              "2026-06-01"
            ]
          }
        },
        "y": {
          "value": -4
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "url": "data/chart5_labels.csv"
      },
      "transform": [
        {
          "filter": "datum.month === '2026-06'"
        },
        {
          "calculate": "datum.region + '  ' + format(datum.visitors_m,'.2f') + 'M (' + (datum.delta >= 0 ? '+' : '−') + format(abs(datum.delta),'.2f') + ')'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "scale": {
            "type": "utc",
            "domain": [
              "2018-01-01",
              "2026-06-01"
            ]
          }
        },
        "y": {
          "field": "mid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              9.6
            ]
          },
          "axis": null
        },
        "text": {
          "field": "lab"
        },
        "color": {
          "field": "region",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "North-East Asia",
              "South-East Asia",
              "South & Central Asia",
              "Oceania",
              "Europe",
              "Americas",
              "Africa & Middle East"
            ],
            "range": [
              "#9e2e6a",
              "#6b8e23",
              "#8c564b",
              "#249fa8",
              "#414faa",
              "#d4a017",
              "#3a3a3a"
            ]
          }
        },
        "opacity": {
          "condition": {
            "param": "region_hover",
            "empty": true,
            "value": 1
          },
          "value": 0.35
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "text": {
      "font": "Arial"
    },
    "axis": {
      "labelColor": "#444"
    }
  },
  "resolve": {
    "scale": {
      "color": "independent"
    }
  }
}