{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Interactive horizon chart: select one of twelve tourism industries to compare its jobs with its 2019 average, Sep 2016 to Jun 2026.",
 "title": {
  "text": {
   "expr": "industrySelector"
  },
  "anchor": "start",
  "fontSize": 13,
  "fontWeight": "normal",
  "color": "#222"
 },
 "width": "container",
 "height": 200,
 "padding": {
  "left": 6,
  "right": 6,
  "top": 6,
  "bottom": 6
 },
 "autosize": {
  "type": "fit",
  "contains": "padding"
 },
 "params": [
  {
   "name": "industrySelector",
   "value": "Accommodation",
   "bind": {
    "input": "select",
    "name": "Industry: ",
    "options": [
     "Accommodation",
     "Cafes, restaurants and takeaway food services",
     "Clubs, pubs, taverns and bars",
     "Road passenger transport and transport equipment rental",
     "Air, water and other passenger transport",
     "Travel agency and information centre services",
     "Cultural services",
     "Casinos and other gambling services",
     "Sports and recreation services",
     "Retail trade",
     "Education and training",
     "Other tourism industries"
    ]
   }
  }
 ],
 "data": {
  "url": "data/chart8_horizon.csv",
  "format": {
   "type": "csv",
   "parse": {
    "jobs_thousands": "number",
    "base": "number",
    "dev": "number",
    "rowpos": "number"
   }
  }
 },
 "transform": [
  {
   "filter": "datum.industry === industrySelector"
  },
  {
   "calculate": "0",
   "as": "rowpos"
  }
 ],
 "layer": [
  {
   "data": {
    "values": [
     {
      "s": "2020-03-20",
      "e": "2022-02-21"
     }
    ]
   },
   "mark": {
    "type": "rect",
    "color": "#d9dde0",
    "opacity": 0.5
   },
   "encoding": {
    "x": {
     "field": "s",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": [
       "2016-09-01",
       "2026-06-01"
      ]
     }
    },
    "x2": {
     "field": "e"
    },
    "y": {
     "value": 0
    },
    "y2": {
     "value": {
      "expr": "height"
     }
    }
   }
  },
  {
   "transform": [
    {
     "calculate": "datum.rowpos * 34 + min(max(datum.dev - 0, 0), 30)",
     "as": "top"
    },
    {
     "calculate": "datum.rowpos * 34",
     "as": "bot"
    }
   ],
   "mark": {
    "type": "area",
    "color": "#2166ac",
    "opacity": 0.38,
    "interpolate": "linear"
   },
   "encoding": {
    "x": {
     "field": "date",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": [
       "2016-09-01",
       "2026-06-01"
      ]
     },
     "title": null,
     "axis": {
      "format": "%Y",
      "tickCount": 10,
      "labelAngle": 0,
      "grid": false,
      "labelFontSize": 12
     }
    },
    "y": {
     "field": "top",
     "type": "quantitative",
     "scale": {
      "domain": [
       0,
       30
      ],
      "nice": false
     },
     "axis": null,
     "stack": null
    },
    "y2": {
     "field": "bot"
    },
    "detail": {
     "field": "industry"
    }
   }
  },
  {
   "transform": [
    {
     "calculate": "datum.rowpos * 34 + min(max(datum.dev - 30, 0), 30)",
     "as": "top"
    },
    {
     "calculate": "datum.rowpos * 34",
     "as": "bot"
    }
   ],
   "mark": {
    "type": "area",
    "color": "#2166ac",
    "opacity": 0.38,
    "interpolate": "linear"
   },
   "encoding": {
    "x": {
     "field": "date",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": [
       "2016-09-01",
       "2026-06-01"
      ]
     },
     "title": null,
     "axis": {
      "format": "%Y",
      "tickCount": 10,
      "labelAngle": 0,
      "grid": false,
      "labelFontSize": 12
     }
    },
    "y": {
     "field": "top",
     "type": "quantitative",
     "scale": {
      "domain": [
       0,
       30
      ],
      "nice": false
     },
     "axis": null,
     "stack": null
    },
    "y2": {
     "field": "bot"
    },
    "detail": {
     "field": "industry"
    }
   }
  },
  {
   "transform": [
    {
     "calculate": "datum.rowpos * 34 + min(max(datum.dev - 60, 0), 30)",
     "as": "top"
    },
    {
     "calculate": "datum.rowpos * 34",
     "as": "bot"
    }
   ],
   "mark": {
    "type": "area",
    "color": "#2166ac",
    "opacity": 0.38,
    "interpolate": "linear"
   },
   "encoding": {
    "x": {
     "field": "date",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": [
       "2016-09-01",
       "2026-06-01"
      ]
     },
     "title": null,
     "axis": {
      "format": "%Y",
      "tickCount": 10,
      "labelAngle": 0,
      "grid": false,
      "labelFontSize": 12
     }
    },
    "y": {
     "field": "top",
     "type": "quantitative",
     "scale": {
      "domain": [
       0,
       30
      ],
      "nice": false
     },
     "axis": null,
     "stack": null
    },
    "y2": {
     "field": "bot"
    },
    "detail": {
     "field": "industry"
    }
   }
  },
  {
   "transform": [
    {
     "calculate": "datum.rowpos * 34 + min(max(-datum.dev - 0, 0), 30)",
     "as": "top"
    },
    {
     "calculate": "datum.rowpos * 34",
     "as": "bot"
    }
   ],
   "mark": {
    "type": "area",
    "color": "#b2182b",
    "opacity": 0.38,
    "interpolate": "linear"
   },
   "encoding": {
    "x": {
     "field": "date",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": [
       "2016-09-01",
       "2026-06-01"
      ]
     },
     "title": null,
     "axis": {
      "format": "%Y",
      "tickCount": 10,
      "labelAngle": 0,
      "grid": false,
      "labelFontSize": 12
     }
    },
    "y": {
     "field": "top",
     "type": "quantitative",
     "scale": {
      "domain": [
       0,
       30
      ],
      "nice": false
     },
     "axis": null,
     "stack": null
    },
    "y2": {
     "field": "bot"
    },
    "detail": {
     "field": "industry"
    }
   }
  },
  {
   "transform": [
    {
     "calculate": "datum.rowpos * 34 + min(max(-datum.dev - 30, 0), 30)",
     "as": "top"
    },
    {
     "calculate": "datum.rowpos * 34",
     "as": "bot"
    }
   ],
   "mark": {
    "type": "area",
    "color": "#b2182b",
    "opacity": 0.38,
    "interpolate": "linear"
   },
   "encoding": {
    "x": {
     "field": "date",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": [
       "2016-09-01",
       "2026-06-01"
      ]
     },
     "title": null,
     "axis": {
      "format": "%Y",
      "tickCount": 10,
      "labelAngle": 0,
      "grid": false,
      "labelFontSize": 12
     }
    },
    "y": {
     "field": "top",
     "type": "quantitative",
     "scale": {
      "domain": [
       0,
       30
      ],
      "nice": false
     },
     "axis": null,
     "stack": null
    },
    "y2": {
     "field": "bot"
    },
    "detail": {
     "field": "industry"
    }
   }
  },
  {
   "transform": [
    {
     "calculate": "datum.rowpos * 34 + min(max(-datum.dev - 60, 0), 30)",
     "as": "top"
    },
    {
     "calculate": "datum.rowpos * 34",
     "as": "bot"
    }
   ],
   "mark": {
    "type": "area",
    "color": "#b2182b",
    "opacity": 0.38,
    "interpolate": "linear"
   },
   "encoding": {
    "x": {
     "field": "date",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": [
       "2016-09-01",
       "2026-06-01"
      ]
     },
     "title": null,
     "axis": {
      "format": "%Y",
      "tickCount": 10,
      "labelAngle": 0,
      "grid": false,
      "labelFontSize": 12
     }
    },
    "y": {
     "field": "top",
     "type": "quantitative",
     "scale": {
      "domain": [
       0,
       30
      ],
      "nice": false
     },
     "axis": null,
     "stack": null
    },
    "y2": {
     "field": "bot"
    },
    "detail": {
     "field": "industry"
    }
   }
  },
  {
   "transform": [
    {
     "calculate": "datum.rowpos * 34",
     "as": "bot"
    }
   ],
   "mark": {
    "type": "rule",
    "color": "#999",
    "strokeWidth": 0.8
   },
   "encoding": {
    "y": {
     "field": "bot",
     "type": "quantitative",
     "scale": {
      "domain": [
       0,
       30
      ],
      "nice": false
     },
     "axis": null
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.quarter_label === '2026-Q2'"
    },
    {
     "calculate": "datum.rowpos * 34 + 15",
     "as": "mid"
    },
    {
     "calculate": "(datum.dev >= 0 ? '+' : '\u2212') + format(abs(datum.dev), '.0f') + '%'",
     "as": "lab"
    }
   ],
   "mark": {
    "type": "text",
    "align": "left",
    "baseline": "middle",
    "dx": 8,
    "fontSize": 13,
    "fontWeight": "bold"
   },
   "encoding": {
    "x": {
     "field": "date",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": [
       "2016-09-01",
       "2026-06-01"
      ]
     }
    },
    "y": {
     "field": "mid",
     "type": "quantitative",
     "scale": {
      "domain": [
       0,
       30
      ],
      "nice": false
     },
     "axis": null
    },
    "text": {
     "field": "lab"
    },
    "color": {
     "condition": {
      "test": "datum.dev >= 0",
      "value": "#2166ac"
     },
     "value": "#b2182b"
    }
   }
  },
  {
   "mark": {
    "type": "bar",
    "opacity": 0
   },
   "encoding": {
    "x": {
     "field": "date",
     "type": "temporal",
     "timeUnit": "utcyearquarter",
     "scale": {
      "type": "utc",
      "domain": [
       "2016-09-01",
       "2026-06-01"
      ]
     }
    },
    "y": {
     "value": 0
    },
    "y2": {
     "value": {
      "expr": "height"
     }
    },
    "tooltip": [
     {
      "field": "name",
      "title": "Industry"
     },
     {
      "field": "quarter_label",
      "title": "Quarter"
     },
     {
      "field": "jobs_thousands",
      "title": "Jobs (thousands)",
      "format": ".1f"
     },
     {
      "field": "dev",
      "title": "vs 2019 average (%)",
      "format": "+.0f"
     }
    ]
   }
  }
 ],
 "config": {
  "view": {
   "stroke": null
  },
  "text": {
   "font": "Arial"
  },
  "axis": {
   "labelColor": "#444"
  }
 }
}