{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Interactive line chart: all twelve tourism industries as grey lines, with the one chosen in the dropdown highlighted, as % difference from its 2019 average, Sep 2016 to Jun 2026.",
 "width": "container",
 "height": 340,
 "padding": {
  "left": 6,
  "right": 48,
  "top": 6,
  "bottom": 6
 },
 "autosize": {
  "type": "fit",
  "contains": "padding"
 },
 "title": {
  "text": {
   "expr": "industrySelector"
  },
  "anchor": "start",
  "fontSize": 14,
  "fontWeight": "bold",
  "font": "Arial",
  "color": "#222",
  "offset": 8
 },
 "params": [
  {
   "name": "industrySelector",
   "value": "Accommodation",
   "bind": {
    "input": "select",
    "name": "Industry: ",
    "options": [
     "Accommodation",
     "Cafes, restaurants and takeaway food services",
     "Clubs, pubs, taverns and bars",
     "Road passenger transport and transport equipment rental",
     "Air, water and other passenger transport",
     "Travel agency and information centre services",
     "Cultural services",
     "Casinos and other gambling services",
     "Sports and recreation services",
     "Retail trade",
     "Education and training",
     "Other tourism industries"
    ]
   }
  }
 ],
 "data": {
  "url": "data/chart8_horizon.csv",
  "format": {
   "type": "csv",
   "parse": {
    "date": "date",
    "jobs_thousands": "number",
    "base": "number",
    "dev": "number",
    "rowpos": "number"
   }
  }
 },
 "layer": [
  {
   "data": {
    "values": [
     {
      "s": "2020-03-20",
      "e": "2022-02-21"
     }
    ]
   },
   "mark": {
    "type": "rect",
    "color": "#d9dde0",
    "opacity": 0.5
   },
   "encoding": {
    "x": {
     "field": "s",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": [
       "2016-09-01",
       "2026-06-01"
      ]
     }
    },
    "x2": {
     "field": "e"
    },
    "y": {
     "value": 0
    },
    "y2": {
     "value": {
      "expr": "height"
     }
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.industry === industrySelector"
    },
    {
     "calculate": "max(datum.dev, 0)",
     "as": "pos"
    },
    {
     "calculate": "0",
     "as": "zero"
    }
   ],
   "mark": {
    "type": "area",
    "color": "#16866d",
    "opacity": 0.28,
    "interpolate": "linear"
   },
   "encoding": {
    "x": {
     "field": "date",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": [
       "2016-09-01",
       "2026-06-01"
      ]
     },
     "title": null,
     "axis": {
      "format": "%Y",
      "tickCount": 10,
      "labelAngle": 0,
      "grid": false,
      "labelFontSize": 12,
      "tickColor": "#bbb"
     }
    },
    "y": {
     "field": "pos",
     "type": "quantitative",
     "scale": {
      "domain": [
       -100,
       80
      ],
      "nice": false
     },
     "axis": {
      "title": "Jobs vs 2019 average",
      "values": [
       -100,
       -75,
       -50,
       -25,
       0,
       25,
       50,
       75
      ],
      "labelExpr": "datum.value == 0 ? '2019 avg' : (datum.value > 0 ? '+' : '−') + abs(datum.value) + '%'",
      "grid": true,
      "gridColor": "#eceff1",
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#555"
     }
    },
    "y2": {
     "field": "zero"
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.industry === industrySelector"
    },
    {
     "calculate": "min(datum.dev, 0)",
     "as": "neg"
    },
    {
     "calculate": "0",
     "as": "zero"
    }
   ],
   "mark": {
    "type": "area",
    "color": "#d6604d",
    "opacity": 0.28,
    "interpolate": "linear"
   },
   "encoding": {
    "x": {
     "field": "date",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": [
       "2016-09-01",
       "2026-06-01"
      ]
     },
     "title": null,
     "axis": {
      "format": "%Y",
      "tickCount": 10,
      "labelAngle": 0,
      "grid": false,
      "labelFontSize": 12,
      "tickColor": "#bbb"
     }
    },
    "y": {
     "field": "neg",
     "type": "quantitative",
     "scale": {
      "domain": [
       -100,
       80
      ],
      "nice": false
     },
     "axis": {
      "title": "Jobs vs 2019 average",
      "values": [
       -100,
       -75,
       -50,
       -25,
       0,
       25,
       50,
       75
      ],
      "labelExpr": "datum.value == 0 ? '2019 avg' : (datum.value > 0 ? '+' : '−') + abs(datum.value) + '%'",
      "grid": true,
      "gridColor": "#eceff1",
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#555"
     }
    },
    "y2": {
     "field": "zero"
    }
   }
  },
  {
   "data": {
    "values": [
     {
      "zero": 0
     }
    ]
   },
   "mark": {
    "type": "rule",
    "color": "#555",
    "strokeWidth": 1
   },
   "encoding": {
    "y": {
     "field": "zero",
     "type": "quantitative",
     "scale": {
      "domain": [
       -100,
       80
      ],
      "nice": false
     },
     "axis": {
      "title": "Jobs vs 2019 average",
      "values": [
       -100,
       -75,
       -50,
       -25,
       0,
       25,
       50,
       75
      ],
      "labelExpr": "datum.value == 0 ? '2019 avg' : (datum.value > 0 ? '+' : '−') + abs(datum.value) + '%'",
      "grid": true,
      "gridColor": "#eceff1",
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#555"
     }
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.industry !== industrySelector"
    }
   ],
   "mark": {
    "type": "line",
    "color": "#b8bec4",
    "strokeWidth": 1.4,
    "opacity": 0.85,
    "interpolate": "linear"
   },
   "encoding": {
    "x": {
     "field": "date",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": [
       "2016-09-01",
       "2026-06-01"
      ]
     },
     "title": null,
     "axis": {
      "format": "%Y",
      "tickCount": 10,
      "labelAngle": 0,
      "grid": false,
      "labelFontSize": 12,
      "tickColor": "#bbb"
     }
    },
    "y": {
     "field": "dev",
     "type": "quantitative",
     "scale": {
      "domain": [
       -100,
       80
      ],
      "nice": false
     },
     "axis": {
      "title": "Jobs vs 2019 average",
      "values": [
       -100,
       -75,
       -50,
       -25,
       0,
       25,
       50,
       75
      ],
      "labelExpr": "datum.value == 0 ? '2019 avg' : (datum.value > 0 ? '+' : '−') + abs(datum.value) + '%'",
      "grid": true,
      "gridColor": "#eceff1",
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#555"
     }
    },
    "detail": {
     "field": "industry"
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.industry === industrySelector"
    }
   ],
   "mark": {
    "type": "line",
    "color": "#222",
    "strokeWidth": 2.6,
    "interpolate": "linear"
   },
   "encoding": {
    "x": {
     "field": "date",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": [
       "2016-09-01",
       "2026-06-01"
      ]
     },
     "title": null,
     "axis": {
      "format": "%Y",
      "tickCount": 10,
      "labelAngle": 0,
      "grid": false,
      "labelFontSize": 12,
      "tickColor": "#bbb"
     }
    },
    "y": {
     "field": "dev",
     "type": "quantitative",
     "scale": {
      "domain": [
       -100,
       80
      ],
      "nice": false
     },
     "axis": {
      "title": "Jobs vs 2019 average",
      "values": [
       -100,
       -75,
       -50,
       -25,
       0,
       25,
       50,
       75
      ],
      "labelExpr": "datum.value == 0 ? '2019 avg' : (datum.value > 0 ? '+' : '−') + abs(datum.value) + '%'",
      "grid": true,
      "gridColor": "#eceff1",
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#555"
     }
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.industry === industrySelector"
    }
   ],
   "mark": {
    "type": "point",
    "filled": true,
    "color": "#222",
    "size": 70,
    "opacity": 0
   },
   "encoding": {
    "x": {
     "field": "date",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": [
       "2016-09-01",
       "2026-06-01"
      ]
     },
     "title": null,
     "axis": {
      "format": "%Y",
      "tickCount": 10,
      "labelAngle": 0,
      "grid": false,
      "labelFontSize": 12,
      "tickColor": "#bbb"
     }
    },
    "y": {
     "field": "dev",
     "type": "quantitative",
     "scale": {
      "domain": [
       -100,
       80
      ],
      "nice": false
     },
     "axis": {
      "title": "Jobs vs 2019 average",
      "values": [
       -100,
       -75,
       -50,
       -25,
       0,
       25,
       50,
       75
      ],
      "labelExpr": "datum.value == 0 ? '2019 avg' : (datum.value > 0 ? '+' : '−') + abs(datum.value) + '%'",
      "grid": true,
      "gridColor": "#eceff1",
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#555"
     }
    },
    "opacity": {
     "condition": {
      "param": "hover",
      "empty": false,
      "value": 1
     },
     "value": 0
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.industry === industrySelector"
    },
    {
     "filter": "datum.quarter_label === '2026-Q2'"
    },
    {
     "calculate": "(datum.dev >= 0 ? '+' : '−') + format(abs(datum.dev), '.0f') + '%'",
     "as": "lab"
    }
   ],
   "mark": {
    "type": "text",
    "align": "left",
    "baseline": "middle",
    "dx": 8,
    "fontSize": 13,
    "fontWeight": "bold"
   },
   "encoding": {
    "x": {
     "field": "date",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": [
       "2016-09-01",
       "2026-06-01"
      ]
     },
     "title": null,
     "axis": {
      "format": "%Y",
      "tickCount": 10,
      "labelAngle": 0,
      "grid": false,
      "labelFontSize": 12,
      "tickColor": "#bbb"
     }
    },
    "y": {
     "field": "dev",
     "type": "quantitative",
     "scale": {
      "domain": [
       -100,
       80
      ],
      "nice": false
     },
     "axis": {
      "title": "Jobs vs 2019 average",
      "values": [
       -100,
       -75,
       -50,
       -25,
       0,
       25,
       50,
       75
      ],
      "labelExpr": "datum.value == 0 ? '2019 avg' : (datum.value > 0 ? '+' : '−') + abs(datum.value) + '%'",
      "grid": true,
      "gridColor": "#eceff1",
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#555"
     }
    },
    "text": {
     "field": "lab"
    },
    "color": {
     "condition": {
      "test": "datum.dev >= 0",
      "value": "#16866d"
     },
     "value": "#d6604d"
    }
   }
  },
  {
   "params": [
    {
     "name": "hover",
     "select": {
      "type": "point",
      "on": "pointerover",
      "fields": [
       "date"
      ],
      "clear": "pointerout"
     }
    }
   ],
   "transform": [
    {
     "filter": "datum.industry === industrySelector"
    },
    {
     "calculate": "time(datum.date) - 46 * 86400000",
     "as": "t0"
    },
    {
     "calculate": "time(datum.date) + 46 * 86400000",
     "as": "t1"
    }
   ],
   "mark": {
    "type": "rect",
    "opacity": 0
   },
   "encoding": {
    "x": {
     "field": "t0",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": [
       "2016-09-01",
       "2026-06-01"
      ]
     },
     "title": null,
     "axis": {
      "format": "%Y",
      "tickCount": 10,
      "labelAngle": 0,
      "grid": false,
      "labelFontSize": 12,
      "tickColor": "#bbb"
     }
    },
    "x2": {
     "field": "t1"
    },
    "y": {
     "value": 0
    },
    "y2": {
     "value": {
      "expr": "height"
     }
    },
    "tooltip": [
     {
      "field": "name",
      "title": "Industry"
     },
     {
      "field": "quarter_label",
      "title": "Quarter"
     },
     {
      "field": "jobs_thousands",
      "title": "Jobs (thousands)",
      "format": ".1f"
     },
     {
      "field": "dev",
      "title": "vs 2019 average (%)",
      "format": "+.0f"
     }
    ]
   }
  }
 ],
 "config": {
  "view": {
   "stroke": null
  },
  "text": {
   "font": "Arial"
  },
  "axis": {
   "labelColor": "#444"
  }
 }
}