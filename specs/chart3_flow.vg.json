{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Flow map with a year slider: curves from the 25 biggest visitor origin countries to Australia. Curve width is visitors in the selected year (calendar years 2017 to 2025, and the 12 months to June 2026); colour is how that compares with calendar 2019.",
 "width": "container",
 "height": 440,
 "autosize": {
  "type": "fit",
  "contains": "padding"
 },
 "padding": {
  "left": 8,
  "right": 8,
  "top": 8,
  "bottom": 8
 },
 "projection": {
  "type": "equalEarth",
  "rotate": [
   -150,
   0,
   0
  ]
 },
 "layer": [
  {
   "data": {
    "sphere": true
   },
   "mark": {
    "type": "geoshape",
    "fill": "#dbe9f3",
    "stroke": "#b9cfdf",
    "strokeWidth": 0.8
   }
  },
  {
   "data": {
    "graticule": {
     "step": [
      30,
      30
     ]
    }
   },
   "mark": {
    "type": "geoshape",
    "fill": null,
    "stroke": "#ffffff",
    "strokeOpacity": 1,
    "strokeWidth": 0.5
   }
  },
  {
   "data": {
    "url": "data/world-110m.json",
    "format": {
     "type": "topojson",
     "feature": "countries"
    }
   },
   "transform": [
    {
     "filter": "datum.id !== '010'"
    }
   ],
   "mark": {
    "type": "geoshape",
    "fill": "#f1f2f0",
    "stroke": "#c9ced3",
    "strokeWidth": 0.5
   }
  },
  {
   "data": {
    "url": "data/chart3_flow.csv",
    "format": {
     "type": "csv",
     "parse": {
      "lon": "number",
      "lat": "number",
      "visitors": "number",
      "visitors_2019": "number",
      "pct_of_2019": "number",
      "year": "number"
     }
    }
   },
   "transform": [
    {
     "filter": "datum.year === year_sel"
    },
    {
     "calculate": "{type: 'LineString', coordinates: [[datum.lon, datum.lat], [134, -26]]}",
     "as": "route"
    },
    {
     "calculate": "datum.pct_of_2019 < 80 ? 'Under 80%' : datum.pct_of_2019 < 95 ? '80–95%' : datum.pct_of_2019 < 105 ? '95–105%' : datum.pct_of_2019 < 125 ? '105–125%' : 'Over 125%'",
     "as": "band"
    }
   ],
   "mark": {
    "type": "geoshape",
    "strokeCap": "round",
    "fill": null
   },
   "encoding": {
    "shape": {
     "field": "route",
     "type": "geojson"
    },
    "stroke": {
     "field": "band",
     "type": "nominal",
     "title": [
      "Visitors compared",
      "with 2019"
     ],
     "scale": {
      "domain": [
       "Under 80%",
       "80–95%",
       "95–105%",
       "105–125%",
       "Over 125%"
      ],
      "range": [
       "#b2182b",
       "#ef8a62",
       "#e0b42f",
       "#67a9cf",
       "#2166ac"
      ]
     },
     "legend": {
      "orient": "bottom-right",
      "direction": "vertical",
      "symbolType": "stroke",
      "symbolStrokeWidth": 6,
      "titleFontSize": 14,
      "labelFontSize": 14,
      "titleLimit": 200,
      "rowPadding": 4,
      "offset": 0
     }
    },
    "strokeWidth": {
     "field": "visitors",
     "type": "quantitative",
     "title": "Visitors per year",
     "scale": {
      "type": "linear",
      "domain": [
       0,
       1500000
      ],
      "range": [
       0.5,
       16
      ]
     },
     "legend": null
    },
    "tooltip": [
     {
      "field": "name",
      "type": "nominal",
      "title": "Country"
     },
     {
      "field": "period",
      "type": "nominal",
      "title": "Period"
     },
     {
      "field": "visitors",
      "type": "quantitative",
      "title": "Visitors in this period",
      "format": ","
     },
     {
      "field": "visitors_2019",
      "type": "quantitative",
      "title": "Visitors in 2019",
      "format": ","
     },
     {
      "field": "pct_of_2019",
      "type": "quantitative",
      "title": "Compared with 2019 (%)",
      "format": ".0f"
     }
    ],
    "opacity": {
     "condition": {
      "param": "country_hover",
      "empty": true,
      "value": 0.8
     },
     "value": 0.12
    }
   },
   "params": [
    {
     "name": "country_hover",
     "select": {
      "type": "point",
      "fields": [
       "name"
      ],
      "on": "pointerover",
      "clear": "pointerout, pointerover[!event.item || event.item.mark.marktype !== 'shape' || !event.item.datum || !event.item.datum.name]"
     }
    }
   ]
  },
  {
   "data": {
    "values": [
     {
      "visitors": 0,
      "route": null
     }
    ]
   },
   "mark": {
    "type": "geoshape",
    "filled": false,
    "interactive": false
   },
   "encoding": {
    "shape": {
     "field": "route",
     "type": "geojson"
    },
    "strokeWidth": {
     "field": "visitors",
     "type": "quantitative",
     "title": "Visitors per year",
     "scale": {
      "type": "linear",
      "domain": [
       0,
       1500000
      ],
      "range": [
       0.5,
       16
      ]
     },
     "legend": {
      "orient": "bottom-left",
      "direction": "vertical",
      "values": [
       100000,
       500000,
       1000000
      ],
      "format": ",.0f",
      "symbolType": "stroke",
      "symbolStrokeColor": "#555",
      "titleFontSize": 14,
      "labelFontSize": 14,
      "rowPadding": 6,
      "offset": 0
     }
    }
   }
  },
  {
   "data": {
    "url": "data/chart3_flow.csv",
    "format": {
     "type": "csv",
     "parse": {
      "lon": "number",
      "lat": "number",
      "pct_of_2019": "number",
      "year": "number"
     }
    }
   },
   "mark": {
    "type": "circle",
    "size": 22,
    "color": "#333",
    "opacity": 0.9
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "opacity": {
     "condition": {
      "param": "country_hover",
      "empty": true,
      "value": 0.9
     },
     "value": 0.12
    }
   },
   "transform": [
    {
     "filter": "datum.year === year_sel"
    }
   ]
  },
  {
   "data": {
    "url": "data/chart3_flow.csv",
