{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Diverging bars: change in visitors since 2019 by purpose of visit and by length of stay (year to June 2026 versus calendar 2019, in thousands), stacked on one shared scale.",
 "padding": {
  "left": 6,
  "right": 150,
  "top": 6,
  "bottom": 6
 },
 "autosize": {
  "type": "pad",
  "contains": "padding"
 },
 "data": {
  "url": "data/chart7_purpose_duration.csv",
  "format": {
   "type": "csv",
   "parse": {
    "v2019": "number",
    "v2026": "number",
    "pct": "number",
    "order": "number"
   }
  }
 },
 "vconcat": [
  {
   "title": {
    "text": "Why visitors come",
    "anchor": "start",
    "fontSize": 16,
    "fontWeight": "bold",
    "color": "#222",
    "offset": 26,
    "font": "Arial",
    "frame": "bounds"
   },
   "height": {
    "step": 34
   },
   "transform": [
    {
     "filter": "datum.group === 'reason'"
    },
    {
     "calculate": "(datum.v2026 - datum.v2019) / 1000",
     "as": "change_k"
    }
   ],
   "layer": [
    {
     "mark": {
      "type": "bar",
      "size": 16
     },
     "encoding": {
      "x": {
       "field": "change_k",
       "type": "quantitative",
       "scale": {
        "domain": [
         -500,
         260
        ],
        "nice": false
       },
       "title": "Change in visitors since 2019 (thousands)",
       "axis": {
        "values": [
         -400,
         -300,
         -200,
         -100,
         0,
         100,
         200
        ],
        "labelExpr": "datum.value == 0 ? '0' : (datum.value > 0 ? '+' : '−') + abs(datum.value)",
        "grid": true,
        "gridColor": "#eceff1",
        "domain": false,
        "ticks": false,
        "titleFontSize": 12,
        "labelFontSize": 12,
        "titlePadding": 8
       }
      },
      "y": {
       "field": "item",
       "type": "nominal",
       "sort": {
        "field": "change_k",
        "op": "min",
        "order": "descending"
       },
       "title": null,
       "axis": {
        "labelFontSize": 12,
        "ticks": false,
        "domain": false,
        "labelLimit": 240,
        "labelPadding": 8,
        "minExtent": 150
       }
      },
      "color": {
       "condition": {
        "test": "datum.change_k >= 0",
        "value": "#2878b5"
       },
       "value": "#d6604d"
      },
      "tooltip": [
       {
        "field": "item",
        "title": "Group"
       },
       {
        "field": "v2019",
        "title": "Calendar 2019",
        "format": ","
       },
       {
        "field": "v2026",
        "title": "Year to Jun 2026",
        "format": ","
       },
       {
        "field": "change_k",
        "title": "Change (thousands)",
        "format": "+,.0f"
       },
       {
        "field": "pct",
        "title": "% of 2019",
        "format": ".0f"
       }
      ]
     }
    },
    {
     "data": {
      "values": [
       {
        "zero": 0
       }
      ]
     },
     "mark": {
      "type": "rule",
      "color": "#555",
      "strokeWidth": 1.2
     },
     "encoding": {
      "x": {
       "field": "zero",
       "type": "quantitative",
       "scale": {
        "domain": [
         -500,
         260
        ],
        "nice": false
       },
       "title": "Change in visitors since 2019 (thousands)"
      }
     }
    },
    {
     "transform": [
      {
       "filter": "datum.change_k >= 0"
      },
      {
       "calculate": "(datum.change_k >= 0 ? '+' : '−') + format(round(abs(datum.change_k)), ',') + 'K'",
       "as": "chg"
      }
     ],
     "mark": {
      "type": "text",
      "align": "left",
      "baseline": "middle",
      "dx": 6,
      "fontSize": 12,
      "fontWeight": "bold",
      "color": "#222"
     },
     "encoding": {
      "x": {
       "field": "change_k",
       "type": "quantitative",
       "scale": {
        "domain": [
         -500,
         260
        ],
        "nice": false
       },
       "title": "Change in visitors since 2019 (thousands)"
      },
      "y": {
       "field": "item",
       "type": "nominal",
       "sort": {
        "field": "change_k",
        "op": "min",
        "order": "descending"
       },
       "title": null,
       "axis": {
        "labelFontSize": 12,
        "ticks": false,
        "domain": false,
        "labelLimit": 240,
        "labelPadding": 8,
        "minExtent": 150
       }
      },
      "text": {
       "field": "chg"
      }
     }
    },
    {
     "transform": [
      {
       "filter": "datum.change_k < 0"
      },
      {
       "calculate": "(datum.change_k >= 0 ? '+' : '−') + format(round(abs(datum.change_k)), ',') + 'K'",
       "as": "chg"
      }
