        "labelFontSize": 12,
        "ticks": false,
        "domain": false,
        "labelLimit": 240,
        "labelPadding": 8,
        "minExtent": 150
       }
      },
      "text": {
       "field": "pl"
      },
      "color": {
       "condition": {
        "test": "datum.pct >= 100",
        "value": "#2878b5"
       },
       "value": "#d6604d"
      }
     }
    },
    {
