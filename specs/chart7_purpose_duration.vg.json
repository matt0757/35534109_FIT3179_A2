       "sort": {
        "field": "change_k",
        "op": "min",
        "order": "descending"
       },
       "title": null,
       "axis": {
        "labelFontSize": 12,
        "ticks": false,
        "domain": false,
        "labelLimit": 240,
        "labelPadding": 8,
        "minExtent": 150
